<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>謎解き探偵ゲーム — 事件簿</title>
<meta name="description" content="孤島の洋館から始まる、なりきり謎解き探偵ゲーム。手がかりを集め、推理し、事件を解決せよ。">

<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#12141c">
<meta name="background-color" content="#0b0c12">

<link rel="icon" type="image/png" sizes="32x32" href="icons/icon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="icons/icon-16.png">
<link rel="icon" type="image/x-icon" href="favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="icons/apple-touch-icon.png">

<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="事件簿">
<meta name="mobile-web-app-capable" content="yes">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;800&family=Noto+Serif+JP:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --void:#12141c;
    --void-deep:#0b0c12;
    --panel:#1b1e29;
    --panel-light:#232735;
    --paper:#ece4d2;
    --paper-dark:#dcd2b8;
    --ink:#e9e3d2;
    --ink-dim:#9aa0b4;
    --ink-faint:#6b7080;
    --crimson:#8f2a35;
    --crimson-bright:#b8394a;
    --gold:#b9924f;
    --gold-soft:#8a7143;
    --line:#33384a;
    --shadow-deep: 0 20px 60px rgba(0,0,0,0.55);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(ellipse 1200px 700px at 50% -10%, #1c2030 0%, var(--void) 45%, var(--void-deep) 100%);
    color:var(--ink);
    font-family:'Noto Serif JP', serif;
    min-height:100vh;
    line-height:1.8;
    overflow-x:hidden;
  }
  .display{ font-family:'Shippori Mincho', serif; }

  body::before{
    content:"";
    position:fixed; inset:0;
    background-image:
      repeating-linear-gradient(0deg, rgba(255,255,255,0.012) 0px, transparent 1px, transparent 2px),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.012) 0px, transparent 1px, transparent 2px);
    pointer-events:none;
    z-index:0;
  }

  .app{
    position:relative;
    max-width:1180px;
    margin:0 auto;
    padding:0 24px 120px;
    z-index:1;
  }

  /* ===== Header ===== */
  header.top{
    padding:44px 0 28px;
    text-align:center;
    border-bottom:1px solid var(--line);
    margin-bottom:32px;
    position:relative;
  }
  .eyebrow{
    letter-spacing:.5em;
    font-size:11px;
    color:var(--gold);
    text-transform:uppercase;
    margin-bottom:14px;
  }
  h1.title{
    font-size:clamp(26px,4.6vw,42px);
    font-weight:800;
    margin:0 0 8px;
    letter-spacing:.06em;
    color:var(--ink);
    text-shadow:0 2px 24px rgba(184,57,74,0.25);
  }
  .subtitle{
    color:var(--ink-dim);
    font-size:14px;
    letter-spacing:.15em;
  }
  .ep-crumb{
    margin-top:10px; font-size:11px; color:var(--ink-faint); letter-spacing:.08em;
    cursor:pointer; display:inline-block;
  }
  .ep-crumb:hover{ color:var(--gold); }
  .install-btn{ display:block; margin:16px auto 0; padding:9px 22px; font-size:12px; letter-spacing:.1em; }

  .phase-rail{
    display:flex; justify-content:center; gap:0; margin-top:26px;
    font-size:12px; letter-spacing:.1em; color:var(--ink-faint);
  }
  .phase-rail .p{ padding:6px 18px; position:relative; }
  .phase-rail .p:not(:last-child)::after{
    content:"—"; position:absolute; right:-6px; color:var(--line);
  }
  .phase-rail .p.active{ color:var(--gold); font-weight:700; }
  .phase-rail .p.done{ color:var(--ink-dim); }

  .screen{ display:none; animation:fadeIn .5s ease; }
  .screen.visible{ display:block; }
  @keyframes fadeIn{ from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);} }

  /* ===== Episode select ===== */
  .case-grid{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:20px; margin:36px 0;
  }
  .case-card{
    background:var(--panel); border:1px solid var(--line); border-radius:2px;
    padding:26px 24px; position:relative; overflow:hidden; cursor:pointer;
    transition:border-color .15s ease, transform .15s ease;
  }
  .case-card:hover{ border-color:var(--gold-soft); transform:translateY(-2px); }
  .case-card.locked{ cursor:default; opacity:.5; }
  .case-card.locked:hover{ transform:none; border-color:var(--line); }
  .case-num{ font-size:11px; letter-spacing:.2em; color:var(--gold); margin-bottom:10px; }
  .case-title{ font-family:'Shippori Mincho',serif; font-size:21px; color:var(--paper); margin-bottom:6px; }
  .case-sub{ font-size:12px; color:var(--ink-faint); margin-bottom:14px; letter-spacing:.08em; }
  .case-teaser{ font-size:13px; color:var(--ink-dim); margin-bottom:16px; }
  .case-status{
    font-size:11px; letter-spacing:.1em; display:inline-block;
    padding:4px 10px; border-radius:20px; border:1px solid var(--gold-soft); color:var(--gold);
  }
  .case-status.cleared{ border-color:#6a8f6f; color:#8fb894; }
  .case-status.locked{ border-color:var(--line); color:var(--ink-faint); }

  /* ===== Prologue ===== */
  .prologue{ max-width:720px; margin:40px auto; text-align:left; }
  .prologue p{ margin:0 0 20px; color:var(--ink); font-size:16px; }
  .prologue .lede{
    font-family:'Shippori Mincho',serif;
    font-size:20px; color:var(--paper);
    border-left:3px solid var(--crimson);
    padding-left:18px; margin-bottom:28px;
  }
  .cast-grid{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
    gap:10px; margin:28px 0 36px;
  }
  .cast-card{
    background:var(--panel); border:1px solid var(--line); border-radius:2px;
    padding:14px 12px; text-align:center;
  }
  .cast-card .role{ font-size:11px; color:var(--gold); letter-spacing:.1em; }
  .cast-card .name{ font-family:'Shippori Mincho',serif; font-size:16px; margin-top:4px; }

  .hint-select{
    max-width:520px; margin:32px auto 0; border:1px solid var(--line); border-radius:2px;
    background:var(--panel); padding:18px 20px;
  }
  .hint-select .hs-label{ font-size:11px; letter-spacing:.12em; color:var(--gold); margin-bottom:10px; }
  .hint-option{
    display:flex; align-items:flex-start; gap:10px; padding:11px 12px; margin-bottom:6px;
    border:1px solid var(--line); border-radius:2px; cursor:pointer; transition:all .15s ease;
  }
  .hint-option:last-child{ margin-bottom:0; }
  .hint-option:hover{ border-color:var(--gold-soft); }
  .hint-option.active{ border-color:var(--gold); background:rgba(185,146,79,0.08); }
  .hint-option input{ margin-top:3px; accent-color:var(--crimson); }
  .hint-option .ho-title{ font-size:13.5px; color:var(--paper); font-family:'Shippori Mincho',serif; }
  .hint-option .ho-desc{ font-size:11.5px; color:var(--ink-faint); margin-top:2px; }

  .cta-row{ text-align:center; margin-top:40px; }
  button.btn{
    font-family:'Shippori Mincho',serif;
    background:var(--crimson);
    color:#f4ece1;
    border:1px solid var(--crimson-bright);
    padding:14px 38px;
    font-size:15px;
    letter-spacing:.15em;
    cursor:pointer;
    border-radius:2px;
    transition:transform .15s ease, background .15s ease, box-shadow .15s ease;
    box-shadow:0 8px 24px rgba(143,42,53,0.3);
  }
  button.btn:hover{ background:var(--crimson-bright); transform:translateY(-1px); }
  button.btn:active{ transform:translateY(0px); }
  button.btn.ghost{
    background:transparent; color:var(--gold); border:1px solid var(--gold-soft);
    box-shadow:none;
  }
  button.btn.ghost:hover{ background:rgba(185,146,79,0.1); }
  button.btn:disabled{ opacity:.35; cursor:not-allowed; transform:none; }

  /* ===== Investigation layout ===== */
  .investigate-layout{
    display:grid; grid-template-columns: 1fr 300px; gap:28px; align-items:start;
  }
  @media (max-width:880px){ .investigate-layout{ grid-template-columns:1fr; } }

  .loc-tabs{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:20px; }
  .loc-tab{
    font-size:12px; letter-spacing:.08em; color:var(--ink-dim);
    background:var(--panel); border:1px solid var(--line);
    padding:8px 14px; border-radius:2px; cursor:pointer;
    transition:all .15s ease;
  }
  .loc-tab.active{ color:var(--gold); border-color:var(--gold-soft); background:var(--panel-light); }
  .loc-tab .count{ color:var(--ink-faint); font-size:10px; margin-left:4px; }

  .clue-list{ display:flex; flex-direction:column; gap:12px; }
  .clue-card{ background:var(--panel); border:1px solid var(--line); border-radius:2px; overflow:hidden; }
  .clue-card.locked-out{ opacity:.4; }
  .clue-card.locked-out .clue-head{ cursor:not-allowed; }
  .clue-card.locked-out .clue-head:hover{ background:none; }
  .clue-card.locked-out .clue-mark{ color:var(--crimson-bright); border-color:var(--crimson); }
  .clue-head{ display:flex; justify-content:space-between; align-items:center; padding:16px 18px; cursor:pointer; user-select:none; }
  .clue-head:hover{ background:var(--panel-light); }
  .clue-title{ font-family:'Shippori Mincho',serif; font-size:16px; color:var(--paper); }
  .clue-sub{ font-size:11px; color:var(--ink-faint); margin-top:3px; letter-spacing:.05em; }
  .clue-mark{ font-size:11px; color:var(--gold); border:1px solid var(--gold-soft); padding:3px 9px; border-radius:20px; white-space:nowrap; margin-left:12px; }
  .clue-mark.unread{ color:var(--ink-faint); border-color:var(--line); }
  .clue-body{ max-height:0; overflow:hidden; transition:max-height .35s ease; border-top:1px solid var(--line); }
  .clue-body.open{ max-height:1200px; }
  .clue-body-inner{ padding:18px 20px 22px; }
  .clue-body-inner p{ margin:0 0 14px; color:var(--ink); font-size:14.5px; }
  .clue-body-inner p:last-child{ margin-bottom:0; }
  .quote{ border-left:2px solid var(--gold-soft); padding:10px 16px; margin:14px 0; background:rgba(185,146,79,0.06); color:var(--paper); font-size:14px; }
  .evidence-tag{ display:inline-block; margin-top:6px; margin-right:6px; font-size:11px; color:var(--void); background:var(--gold); padding:3px 10px; border-radius:2px; letter-spacing:.05em; }

  .notebook{
    background:var(--paper); color:#2a2418; border-radius:2px;
    padding:22px 20px; position:sticky; top:20px;
    box-shadow:var(--shadow-deep);
    border:1px solid var(--paper-dark);
  }
  .notebook h3{ font-family:'Shippori Mincho',serif; margin:0 0 4px; font-size:17px; border-bottom:2px solid #2a2418; padding-bottom:10px; }
  .notebook .nb-sub{ font-size:11px; color:#6b6148; margin-bottom:14px; letter-spacing:.06em;}
  .nb-item{ font-size:12.5px; padding:9px 0; border-bottom:1px dashed #c9bc98; display:flex; gap:8px; }
  .nb-item:last-child{ border-bottom:none; }
  .nb-item .dot{ color:var(--crimson); flex-shrink:0; }
  .nb-empty{ font-size:12px; color:#8a7f60; font-style:italic; }
  .nb-progress{ margin-top:16px; font-size:11px; color:#6b6148; text-align:right; transition:color .15s ease; }
  .nb-progress.budget-flash{ color:var(--crimson); font-weight:700; }
  @keyframes flashWarn{ 0%,100%{opacity:1;} 50%{opacity:.4;} }
  .budget-flash{ animation:flashWarn .35s ease 2; }

  .stepper-row{ display:flex; justify-content:space-between; margin-top:32px; }

  /* ===== Deduction ===== */
  .deduction-wrap{ max-width:760px; margin:0 auto; }
  .q-block{ background:var(--panel); border:1px solid var(--line); border-radius:2px; padding:26px 26px 22px; margin-bottom:22px; }
  .q-num{ font-size:11px; color:var(--gold); letter-spacing:.15em; margin-bottom:8px;}
  .q-text{ font-family:'Shippori Mincho',serif; font-size:19px; color:var(--paper); margin-bottom:18px; }
  .opt{ display:flex; align-items:flex-start; gap:12px; padding:13px 16px; margin-bottom:8px; border:1px solid var(--line); border-radius:2px; cursor:pointer; transition:all .15s ease; }
  .opt:hover{ border-color:var(--gold-soft); background:var(--panel-light); }
  .opt.selected{ border-color:var(--gold); background:rgba(185,146,79,0.1); }
  .opt input{ margin-top:3px; accent-color:var(--crimson); }
  .opt-label{ font-size:14px; color:var(--ink); }

  /* ===== Result ===== */
  .result-banner{ text-align:center; padding:34px 20px 24px; margin-bottom:8px; }
  .result-banner .verdict{ font-family:'Shippori Mincho',serif; font-size:30px; font-weight:800; letter-spacing:.08em; }
  .result-banner.correct .verdict{ color:#c7a95f; }
  .result-banner.wrong .verdict{ color:var(--ink-dim); }
  .result-banner .sub{ color:var(--ink-dim); font-size:13px; margin-top:8px; letter-spacing:.08em; }

  .solution-section{ background:var(--panel); border:1px solid var(--line); border-radius:2px; padding:28px 30px; margin-bottom:20px; }
  .solution-section h2{ font-family:'Shippori Mincho',serif; font-size:20px; color:var(--paper); margin:0 0 6px; border-bottom:1px solid var(--line); padding-bottom:14px; }
  .solution-section h2 .num{ color:var(--crimson-bright); margin-right:8px; }
  .solution-section p{ font-size:14.5px; color:var(--ink); margin:14px 0; }

  table.evidence-table{ width:100%; border-collapse:collapse; margin-top:10px; font-size:13px; }
  table.evidence-table th, table.evidence-table td{ border:1px solid var(--line); padding:10px 12px; text-align:left; color:var(--ink); }
  table.evidence-table th{ background:var(--panel-light); color:var(--gold); font-weight:500; letter-spacing:.05em; }

  .epilogue-block .char{ margin-bottom:16px; }
  .epilogue-block .char .who{ color:var(--gold); font-size:12px; letter-spacing:.1em; margin-bottom:4px; }

  .toggle-alt{ text-align:center; margin:30px 0; }
  .alt-route{ display:none; background:linear-gradient(180deg, rgba(143,42,53,0.08), transparent); border:1px solid var(--crimson); border-radius:2px; padding:28px 30px; margin-top:10px; }
  .alt-route.visible{ display:block; animation:fadeIn .5s ease; }
  .alt-route h2{ color:var(--crimson-bright); font-family:'Shippori Mincho',serif; margin-top:0;}

  footer.end{ text-align:center; margin-top:50px; color:var(--ink-faint); font-size:12px; letter-spacing:.1em; }

  ::selection{ background:var(--crimson); color:#fff; }

  @media(max-width:600px){
    .app{ padding:0 14px 100px; }
    .solution-section, .q-block{ padding:20px 18px; }
  }
</style>
</head>
<body>
<div class="app">

  <header class="top">
    <div class="eyebrow">MURDER MYSTERY · 推理探偵ゲーム</div>
    <h1 class="title display" id="headerTitle">事件簿</h1>
    <div class="subtitle" id="headerSubtitle">EPISODE ARCHIVE</div>
    <div class="ep-crumb" id="epCrumb" style="display:none;" onclick="goSelect()">← 事件一覧に戻る</div>
    <button id="installBtn" class="btn ghost install-btn" style="display:none;">📥 アプリをインストール</button>
    <div class="phase-rail" id="phaseRail" style="display:none;">
      <div class="p" data-phase="0">序章</div>
      <div class="p" data-phase="1">捜査</div>
      <div class="p" data-phase="2">推理</div>
      <div class="p" data-phase="3">解決</div>
    </div>
  </header>

  <!-- ===================== SCREEN: EPISODE SELECT ===================== -->
  <section class="screen visible" id="screen-select">
    <p style="text-align:center; color:var(--ink-dim); font-size:14px; max-width:560px; margin:0 auto;">
      解決した事件、まだ見ぬ事件——探偵の元に届いた依頼の記録。挑む事件を選んでください。
    </p>
    <div class="case-grid" id="caseGrid"></div>
  </section>

  <!-- ===================== SCREEN 0: PROLOGUE ===================== -->
  <section class="screen" id="screen-0">
    <div class="prologue" id="prologueContent"></div>
  </section>

  <!-- ===================== SCREEN 1: INVESTIGATION ===================== -->
  <section class="screen" id="screen-1">
    <div class="investigate-layout">
      <div>
        <div class="loc-tabs" id="locTabs"></div>
        <div class="clue-list" id="clueList"></div>
        <div class="stepper-row">
          <button class="btn ghost" onclick="goPhase(0)">← 序章に戻る</button>
          <button class="btn" id="toDeductionBtn" onclick="goPhase(2)" disabled>推理へ進む →</button>
        </div>
      </div>
      <div class="notebook">
        <h3 class="display">捜査ノート</h3>
        <div class="nb-sub">収集した証拠</div>
        <div id="nbList"><div class="nb-empty">まだ証拠はありません。カードを開いて調べましょう。</div></div>
        <div class="nb-progress" id="nbProgress">0 / 0 件の手がかりを確認</div>
      </div>
    </div>
  </section>

  <!-- ===================== SCREEN 2: DEDUCTION ===================== -->
  <section class="screen" id="screen-2">
    <div class="deduction-wrap" id="deductionContent"></div>
  </section>

  <!-- ===================== SCREEN 3: RESULT / SOLUTION ===================== -->
  <section class="screen" id="screen-3">
    <div id="resultBanner" class="result-banner"></div>
    <div id="resultBody"></div>
  </section>

</div>

<script>
/* ========================================================================
   HOW TO ADD A NEW EPISODE
   ------------------------------------------------------------------------
   1. Copy the "episode1" object below as a template.
   2. Give it a unique `id`, the next `number`, a `title`/`subtitle`/`teaser`.
   3. Set `status` to "available" (or "locked" to show a "coming soon" card).
   4. Fill `locations` (tabs) and `clues` (investigation cards). Each clue's
      `evidence` array feeds the notebook sidebar automatically.
   5. Fill `questions.q1/q2/q3` (deduction multiple choice) and `correct`
      (the id of the right option for each question).
   6. Fill `solutionSections`, `evidenceTable`, `epilogue`, and optionally
      `altRoute` (an alternate "what if" ending shown after solving).
   7. Push the new object into the `episodes` array at the bottom.
   That's it — the select screen, prologue, investigation, deduction and
   result screens are all rendered generically from this data.
   ======================================================================== */

const episode1 = {
  id: "shirasagi",
  number: 1,
  title: "孤島の洋館殺人事件",
  subtitle: "白鷺荘",
  teaser: "資産家の古希祝いの夜、書斎で当主が息絶えた。嵐で外部と遮断された孤島の洋館で、あなたは真相を突き止められるか。",
  status: "available",

  prologueLede: "資産家・九条源一郎の古希を祝う晩餐会の夜、彼は書斎で息絶えていた。嵐で船は出せず、孤島は外部と遮断されている。警察が来るまで、事件を解けるのはあなただけだ。",
  prologueParagraphs: [
    "テーブルの上には、赤ワインの残ったグラスがひとつ。医師の見立てでは死因は毒物――だが、遺体に苦悶の跡はなく、その死に顔はどこか穏やかだった。",
    "あなたは名探偵として招待されたこの屋敷で、真相を突き止めることになる。助手とともに、現場・遺体・関係者を調べ、証拠を集め、犯人を指摘せよ。"
  ],
  cast: [
    { role:"後妻", name:"九条 秋子" },
    { role:"長男・後継者候補", name:"九条 隆之" },
    { role:"長女・画家", name:"九条 美咲" },
    { role:"執事", name:"田原" },
    { role:"主治医", name:"黒木" },
    { role:"秘書", name:"柊" },
  ],

  locations: [
    { id:"body",     label:"遺体・グラス" },
    { id:"kuroki",   label:"主治医・黒木" },
    { id:"kura",     label:"倉庫・薬品" },
    { id:"papers",   label:"書斎の書類" },
    { id:"takayuki", label:"長男・隆之" },
    { id:"hiiragi",  label:"秘書・柊" },
    { id:"tahara",   label:"執事・田原" },
    { id:"relations",label:"人間関係" },
    { id:"search",   label:"密かな捜索" },
  ],

  investigationBudget: 12,
  unlockThreshold: 9,

  clues: [
    { id:"c1", loc:"body", title:"遺体の状況", sub:"書斎・第一発見時",
      body:[
        "書斎の革張りの椅子に寄りかかるように座った源一郎。表情は苦悶ではなく、むしろ穏やか。痙攣や嘔吐の跡はなく、外傷もない。",
        "死後およそ1〜2時間が経過（黒木医師の簡易診断）。テーブルにはワイングラスがひとつだけ、そして会社の契約書らしき書類が数枚置かれていた。"
      ],
      evidence:["遺体に苦悶の跡なし（穏やかな死に顔）","グラスは1つのみ、契約書らしき書類あり"]
    },
    { id:"c2", loc:"body", title:"ワイングラスの検分", sub:"香り・指紋・ボトルの所在",
