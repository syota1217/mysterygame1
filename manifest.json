      "<strong>犯行の実像：</strong>神尾は支倉の部屋を訪れた際、すでに弱っていた支倉を見て『好機』と判断し、残っていたブランデーに追加の薬を混入。退室時に鍵穴から工作して密室を偽装し、遠野とすれ違ったのは単なる偶然だった——という筋書きも、成立してしまう。",
    ],
    note:"※ 神尾の『最初に嘘をついた』という事実は、実際には別の動機（疑われたくなかっただけ）でしたが、もし彼の証言そのものが最初から嘘だったなら、この筋書きも否定はできません。今回の正解ルートは『後妻・冬子の単独犯行』でした。"
  },
  redHerrings: [
    "亮の高額出金明細：鑑定機器の購入費用で、事件とは無関係だった。",
    "黒沢の取材ノートの走り書き：幻に終わった単独インタビューの予定で、事件とは無関係だった。",
  ]
};

const episode3Placeholder = {
  id:"placeholder-3", number:3, title:"次なる事件簿", subtitle:"近日公開",
  teaser:"新しい事件は、まだ捜査ファイルが届いていない。", status:"locked"
};

const episodes = [ episode1, episode2, episode3Placeholder ];

/* ========================================================================
   STATE
   ======================================================================== */
let currentEpisode = null;
let currentLoc = null;
let openedClues = new Set();
let collectedEvidence = [];
let selected = { q1:null, q2:null, q3:null };
let clearedEpisodes = new Set();
let hintLevel = "standard"; // "standard" | "hard"
let cluesUsed = 0;

/* ========================================================================
   EPISODE SELECT SCREEN
   ======================================================================== */
function renderCaseGrid(){
  const grid = document.getElementById("caseGrid");
  grid.innerHTML = "";
  episodes.forEach(ep=>{
    const locked = ep.status === "locked";
    const cleared = clearedEpisodes.has(ep.id);
    const card = document.createElement("div");
    card.className = "case-card" + (locked ? " locked":"");
    card.innerHTML = `
      <div class="case-num">FILE No.${String(ep.number).padStart(2,"0")}</div>
      <div class="case-title display">${ep.title}</div>
      <div class="case-sub">${ep.subtitle}</div>
      <div class="case-teaser">${ep.teaser}</div>
      <div class="case-status ${locked?'locked':(cleared?'cleared':'')}">${locked ? "近日公開" : (cleared ? "解決済み" : "捜査可能")}</div>
    `;
    if(!locked){ card.onclick = ()=> loadEpisode(ep); }
    grid.appendChild(card);
  });
}

function goSelect(){
  currentEpisode = null;
  document.getElementById("epCrumb").style.display = "none";
  document.getElementById("phaseRail").style.display = "none";
  document.getElementById("headerTitle").textContent = "事件簿";
  document.getElementById("headerSubtitle").textContent = "EPISODE ARCHIVE";
  document.querySelectorAll(".screen").forEach(s=>s.classList.remove("visible"));
  document.getElementById("screen-select").classList.add("visible");
  renderCaseGrid();
  window.scrollTo({top:0, behavior:"smooth"});
}

function loadEpisode(ep){
  currentEpisode = ep;
  openedClues = new Set();
  collectedEvidence = [];
  selected = { q1:null, q2:null, q3:null };
  hintLevel = "standard";
  cluesUsed = 0;
  currentLoc = ep.locations[0].id;

  document.getElementById("epCrumb").style.display = "inline-block";
  document.getElementById("phaseRail").style.display = "flex";
  document.getElementById("headerTitle").textContent = ep.title;
  document.getElementById("headerSubtitle").textContent = ep.subtitle;

  renderPrologue();
  goPhase(0);
}

/* ========================================================================
   PROLOGUE
   ======================================================================== */
function renderPrologue(){
  const ep = currentEpisode;
  const wrap = document.getElementById("prologueContent");
  wrap.innerHTML = `
    <p class="lede display">${ep.prologueLede}</p>
    ${ep.prologueParagraphs.map(p=>`<p>${p}</p>`).join("")}
    <div class="cast-grid">
      ${ep.cast.map(c=>`<div class="cast-card"><div class="role">${c.role}</div><div class="name display">${c.name}</div></div>`).join("")}
    </div>

    <div class="hint-select">
      <div class="hs-label">捜査ルール</div>
      <p style="font-size:13px; color:var(--ink-dim); margin:0 0 14px;">
        今回、現場や関係者を調べられる回数には上限があります。手がかりは全部で<strong style="color:var(--paper);">${ep.clues.length}件</strong>ありますが、確認できるのは<strong style="color:var(--gold);">${ep.investigationBudget}回まで</strong>。どこを重点的に調べるか、天才探偵自身の判断が問われます。
      </p>
      <div class="hs-label">捜査モードを選ぶ</div>
      <label class="hint-option ${hintLevel==='standard'?'active':''}" id="hintOptStandard">
        <input type="radio" name="hintLevel" ${hintLevel==='standard'?'checked':''}>
        <div>
          <div class="ho-title display">標準モード</div>
          <div class="ho-desc">捜査ノートに、確認した手がかりの要点が自動で記録されます。</div>
        </div>
      </label>
      <label class="hint-option ${hintLevel==='hard'?'active':''}" id="hintOptHard">
        <input type="radio" name="hintLevel" ${hintLevel==='hard'?'checked':''}>
        <div>
          <div class="ho-title display">ハードモード</div>
          <div class="ho-desc">捜査ノートには確認済みの件数だけが表示されます。証言や物証の意味は、自分の記憶と推理だけで読み解いてください。</div>
        </div>
      </label>
    </div>

    <div class="cta-row">
      <button class="btn" onclick="goPhase(1)">捜査を開始する →</button>
    </div>
  `;
  document.getElementById("hintOptStandard").onclick = ()=>{ hintLevel="standard"; renderPrologue(); };
  document.getElementById("hintOptHard").onclick = ()=>{ hintLevel="hard"; renderPrologue(); };
}

/* ========================================================================
   RENDER: LOCATION TABS + CLUES
   ======================================================================== */
function renderTabs(){
  const ep = currentEpisode;
  const wrap = document.getElementById("locTabs");
  wrap.innerHTML = "";
  ep.locations.forEach(loc=>{
    const total = ep.clues.filter(c=>c.loc===loc.id).length;
    const done = ep.clues.filter(c=>c.loc===loc.id && openedClues.has(c.id)).length;
    const el = document.createElement("div");
    el.className = "loc-tab" + (loc.id===currentLoc ? " active":"");
    el.innerHTML = `${loc.label}<span class="count">${done}/${total}</span>`;
    el.onclick = ()=>{ currentLoc = loc.id; renderTabs(); renderClues(); };
    wrap.appendChild(el);
  });
}

function renderClues(){
  const ep = currentEpisode;
  const wrap = document.getElementById("clueList");
  wrap.innerHTML = "";
  const exhausted = cluesUsed >= ep.investigationBudget;
  ep.clues.filter(c=>c.loc===currentLoc).forEach(c=>{
    const isOpen = openedClues.has(c.id);
    const isLocked = !isOpen && exhausted;
    const card = document.createElement("div");
    card.className = "clue-card" + (isLocked ? " locked-out" : "");
    card.innerHTML = `
      <div class="clue-head" onclick="toggleClue('${c.id}')">
        <div>
          <div class="clue-title display">${c.title}</div>
          <div class="clue-sub">${c.sub}</div>
        </div>
        <div class="clue-mark ${isOpen?'':'unread'}">${isOpen ? '確認済み' : (isLocked ? '捜査打ち切り' : '未確認')}</div>
      </div>
      <div class="clue-body ${isOpen?'open':''}" id="body-${c.id}">
        <div class="clue-body-inner">
          ${c.body.map((p,i)=> i>=1 && (c.body.length>1) ? `<div class="quote">${p}</div>` : `<p>${p}</p>`).join("")}
          ${hintLevel==="standard" ? c.evidence.map(e=>`<div class="evidence-tag">証拠：${e}</div>`).join(" ") : ""}
        </div>
      </div>
    `;
    wrap.appendChild(card);
  });
}

function toggleClue(id){
  const ep = currentEpisode;
  const wasOpen = openedClues.has(id);
  const bodyEl = document.getElementById("body-"+id);
  if(wasOpen){
    bodyEl.classList.remove("open");
  } else {
    if(cluesUsed >= ep.investigationBudget){
      flashBudgetWarning();
      return;
    }
    cluesUsed++;
    openedClues.add(id);
    const clue = ep.clues.find(c=>c.id===id);
    clue.evidence.forEach(e=>{
      if(!collectedEvidence.includes(e)) collectedEvidence.push(e);
    });
    bodyEl.classList.add("open");
    renderNotebook();
    renderTabs();
    renderClues(); // re-render so any now-exhausted cards lock visually
    checkDeductionUnlock();
    return;
  }
  checkDeductionUnlock();
}

function flashBudgetWarning(){
  const el = document.getElementById("nbProgress");
  if(!el) return;
  el.classList.add("budget-flash");
  setTimeout(()=> el.classList.remove("budget-flash"), 700);
}

function renderNotebook(){
  const list = document.getElementById("nbList");
  const totalClues = currentEpisode.clues.length;
  const opened = openedClues.size;

  if(hintLevel==="hard"){
    if(opened===0){
      list.innerHTML = `<div class="nb-empty">まだ何も調べていません。捜査を始めましょう。</div>`;
    } else {
      list.innerHTML = `<div class="nb-item"><span class="dot">◆</span><span>ハードモードのため、詳細は記録されません。証言や物証の内容は自分の記憶を頼りに整理してください。</span></div>`;
    }
  } else if(collectedEvidence.length===0){
    list.innerHTML = `<div class="nb-empty">まだ証拠はありません。カードを開いて調べましょう。</div>`;
  } else {
    list.innerHTML = collectedEvidence.map(e=>`<div class="nb-item"><span class="dot">◆</span><span>${e}</span></div>`).join("");
  }
  document.getElementById("nbProgress").textContent = `${opened} / ${totalClues} 件を確認（残り捜査回数 ${Math.max(0, currentEpisode.investigationBudget - cluesUsed)}）`;
}

function checkDeductionUnlock(){
  const ep = currentEpisode;
  const btn = document.getElementById("toDeductionBtn");
  const need = ep.unlockThreshold;
  btn.disabled = openedClues.size < need;
  btn.textContent = openedClues.size < need
    ? `推理へ進む → （あと${need-openedClues.size}件調べましょう）`
    : "推理へ進む →";
}

/* ========================================================================
   PHASE NAVIGATION
   ======================================================================== */
function goPhase(n){
  document.querySelectorAll(".screen").forEach(s=>s.classList.remove("visible"));
  document.getElementById("screen-"+n).classList.add("visible");
  document.querySelectorAll(".phase-rail .p").forEach(p=>{
    const pn = parseInt(p.dataset.phase);
    p.classList.toggle("active", pn===n);
    p.classList.toggle("done", pn<n);
  });
  window.scrollTo({top:0, behavior:"smooth"});
  if(n===1){ renderTabs(); renderClues(); renderNotebook(); checkDeductionUnlock(); }
  if(n===2){ renderDeduction(); }
}

/* ========================================================================
   DEDUCTION
   ======================================================================== */
function renderDeduction(){
  const ep = currentEpisode;
  const wrap = document.getElementById("deductionContent");
  wrap.innerHTML = `
    <div class="q-block">
      <div class="q-num">QUESTION 1</div>
      <div class="q-text display">犯人は誰か。</div>
      <div id="q1opts"></div>
    </div>
    <div class="q-block">
      <div class="q-num">QUESTION 2</div>
      <div class="q-text display">凶器・実行方法として最も正しいものは？</div>
      <div id="q2opts"></div>
    </div>
    <div class="q-block">
      <div class="q-num">QUESTION 3</div>
      <div class="q-text display">動機は何だったか。</div>
      <div id="q3opts"></div>
    </div>
    <div class="cta-row">
      <button class="btn" id="submitBtn" onclick="submitDeduction()" disabled>推理を披露する →</button>
    </div>
    <div class="stepper-row" style="justify-content:center;margin-top:16px;">
      <button class="btn ghost" onclick="goPhase(1)">← 捜査に戻る</button>
    </div>
  `;
  shuffledQ = {
    q1: shuffleArr(ep.questions.q1),
    q2: shuffleArr(ep.questions.q2),
    q3: shuffleArr(ep.questions.q3),
  };
  renderOpts("q1opts", shuffledQ.q1, "q1");
  renderOpts("q2opts", shuffledQ.q2, "q2");
  renderOpts("q3opts", shuffledQ.q3, "q3");
}
let shuffledQ = { q1:[], q2:[], q3:[] };
function shuffleArr(arr){
  const a = arr.slice();
  for(let i=a.length-1; i>0; i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]] = [a[j],a[i]];
  }
  return a;
}
function renderOpts(elId, options, qkey){
  const wrap = document.getElementById(elId);
  wrap.innerHTML = "";
  options.forEach(o=>{
    const row = document.createElement("label");
    row.className = "opt" + (selected[qkey]===o.id ? " selected":"");
    row.innerHTML = `<input type="radio" name="${qkey}" ${selected[qkey]===o.id?'checked':''}/><span class="opt-label">${o.label}</span>`;
    row.onclick = ()=>{ selected[qkey]=o.id; renderOpts(elId, shuffledQ[qkey], qkey); checkSubmit(); };
    wrap.appendChild(row);
  });
}
function checkSubmit(){
  const btn = document.getElementById("submitBtn");
  if(btn) btn.disabled = !(selected.q1 && selected.q2 && selected.q3);
}

function submitDeduction(){
  const ep = currentEpisode;
  const correct = selected.q1===ep.correct.q1 && selected.q2===ep.correct.q2 && selected.q3===ep.correct.q3;
  const correctCount = [selected.q1===ep.correct.q1, selected.q2===ep.correct.q2, selected.q3===ep.correct.q3].filter(Boolean).length;
  if(correct) clearedEpisodes.add(ep.id);
  renderResult(correct, correctCount);
  goPhase(3);
}

/* ========================================================================
   RESULT / SOLUTION
   ======================================================================== */
function renderResult(correct, correctCount){
  const ep = currentEpisode;
  const banner = document.getElementById("resultBanner");
  const body = document.getElementById("resultBody");

  if(correct){
    banner.className = "result-banner correct";
    banner.innerHTML = `
      <div class="verdict display">推理的中 —— 事件解決</div>
      <div class="sub">3問すべて正解。あなたは真相にたどり着いた。</div>
    `;
  } else {
    banner.className = "result-banner wrong";
    banner.innerHTML = `
      <div class="verdict display">推理再考の余地あり</div>
      <div class="sub">${correctCount} / 3 問正解。証拠を見直し、もう一度挑戦することもできます。</div>
    `;
  }

  const sections = ep.solutionSections.map((s,i)=>`
    <div class="solution-section">
      <h2 class="display"><span class="num">${s.title.split("　")[0]}</span>${s.title.split("　")[1]||""}</h2>
      <p>${s.html}</p>
    </div>
  `).join("");

  const evidenceRows = ep.evidenceTable.map(r=>`<tr><td>${r[0]}</td><td>${r[1]}</td><td>${r[2]}</td></tr>`).join("");

  const epChars = ep.epilogue.characters.map(c=>`
    <div class="char"><div class="who">${c.who}</div><p>${c.text}</p></div>
  `).join("");

  const altP = ep.altRoute ? ep.altRoute.paragraphs.map(p=>`<p>${p}</p>`).join("") : "";

  body.innerHTML = `
    ${sections}
    <div class="solution-section">
      <h2 class="display"><span class="num">証拠</span>一覧（時系列）</h2>
      <table class="evidence-table">
        <tr><th>#</th><th>証拠</th><th>意味</th></tr>
        ${evidenceRows}
      </table>
    </div>
    ${ep.redHerrings && ep.redHerrings.length ? `
    <div class="solution-section">
      <h2 class="display"><span class="num">補足</span>ミスリードだった手がかり</h2>
      <p style="margin-bottom:10px;">捜査中に見つかった、事件とは直接関係のなかった手がかりです。</p>
      ${ep.redHerrings.map(r=>`<p>・${r}</p>`).join("")}
    </div>` : ""}
    <div class="solution-section epilogue-block">
      <h2 class="display"><span class="num">終章</span>エピローグ</h2>
      <p>${ep.epilogue.intro}</p>
      ${epChars}
      <p style="margin-top:20px;">${ep.epilogue.outro}</p>
    </div>
    ${ep.altRoute ? `
    <div class="toggle-alt">
      <button class="btn ghost" onclick="toggleAlt()">もうひとつの可能性を読む（IFルート）</button>
    </div>
    <div class="alt-route" id="altRoute">
      <h2 class="display">${ep.altRoute.title}</h2>
      ${altP}
      <p style="color:var(--ink-dim); font-size:13px; margin-top:18px;">${ep.altRoute.note}</p>
    </div>` : ""}
    <div class="cta-row" style="margin-top:36px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
      <button class="btn ghost" onclick="loadEpisode(currentEpisode)">この事件を遊び直す</button>
      <button class="btn" onclick="goSelect()">事件一覧に戻る</button>
    </div>
  `;
}

function toggleAlt(){
  document.getElementById("altRoute").classList.toggle("visible");
}

/* init */
renderCaseGrid();

/* ========================================================================
   PWA: service worker + install prompt
   ======================================================================== */
if("serviceWorker" in navigator){
  window.addEventListener("load", ()=>{
    navigator.serviceWorker.register("sw.js").catch(()=>{ /* offline caching is optional */ });
  });
}

let deferredInstallPrompt = null;
const installBtn = document.getElementById("installBtn");

window.addEventListener("beforeinstallprompt", (e)=>{
  e.preventDefault();
  deferredInstallPrompt = e;
  if(installBtn) installBtn.style.display = "inline-block";
});

if(installBtn){
  installBtn.addEventListener("click", async ()=>{
    if(!deferredInstallPrompt) return;
    deferredInstallPrompt.prompt();
    await deferredInstallPrompt.userChoice;
    deferredInstallPrompt = null;
    installBtn.style.display = "none";
  });
}

window.addEventListener("appinstalled", ()=>{
  if(installBtn) installBtn.style.display = "none";
});
</script>
</body>
</html>
